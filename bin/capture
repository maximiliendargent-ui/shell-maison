#!/usr/bin/env bash
# Capture d'écran annotable (grim, slurp, satty) : capture [zone|ecran].
# Dans satty : Entrée copie dans le presse-papiers et ferme, Ctrl + S enregistre dans ~/Pictures/Screenshots,
# Échap ferme sans rien garder.
set -euo pipefail

zone=()
if [[ ${1:-zone} == zone ]]; then
    zone=(-g "$(slurp)") || exit 0  # Échap pendant la sélection
fi
grim "${zone[@]}" - | satty --filename - \
    --output-filename ~/Pictures/Screenshots/capture-%Y-%m-%d_%H-%M-%S.png \
    --copy-command wl-copy \
    --actions-on-enter save-to-clipboard,exit \
    --actions-on-escape exit \
    --early-exit save \
    --floating-hack
